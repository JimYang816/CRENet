# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
.ipynb_checkpoints/
/tmp/
/torchinductor_*/

# Local environments
.venv/
venv/
.env
.env.*
!.env.example

# Datasets: retain the directory structure
/data/**
!/data/**/
!/data/**/.gitkeep

# Experiment outputs: keep directories and version-controlled test source only
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep
!/outputs/__init__.py
!/outputs/smoke/__init__.py
!/outputs/smoke/conftest.py
!/outputs/smoke/tests/**/*.py
!/outputs/smoke/data_generation_tests/**/*.py

# Preserve local historical snapshots without traversing nested worktrees/caches
/outputs/experiment/archive/
/outputs/experiment/_control/
/outputs/experiment/_worktrees/
